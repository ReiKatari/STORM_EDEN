<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="4dp">

    <!-- Active Amiibo Status Card (visible during emulation) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_active_amiibo"
        style="@style/EdenCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/eden_primary"
        app:strokeWidth="1dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_amiibo"
                app:tint="@color/eden_primary"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_active_amiibo_status"
                style="@style/SynthwaveText.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/eden_primary"
                tools:text="🟢 Активен: Mario (Super Smash Bros.)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_disconnect_amiibo"
                style="@style/EdenButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:minHeight="0dp"
                android:textSize="10sp"
                android:text="@string/amiibo_disconnect_button"
                android:textColor="#FF4D4D"
                app:strokeColor="#FF4D4D"
                android:paddingHorizontal="6dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_search"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="?attr/colorPrimary"
            app:hintTextColor="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_amiibo_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingVertical="8dp"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_refresh"
            style="@style/EdenButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/refresh"
            android:textSize="11sp"
            android:paddingHorizontal="10dp" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="3dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_series"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true" />

    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_amiibo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            tools:listitem="@layout/list_item_amiibo" />

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_empty_amiibo"
            style="@style/SynthwaveText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_amiibo_found"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Pagination & Status Toolbar -->
    <LinearLayout
        android:id="@+id/layout_pagination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="1dp"
        android:paddingHorizontal="4dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_status"
            style="@style/SynthwaveText.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:alpha="0.8"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Всего: 850" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_first_page"
                style="@style/EdenButton.Outlined"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="&lt;&lt;"
                android:textSize="10sp"
                android:enabled="false"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_prev_page"
                style="@style/EdenButton.Outlined"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="4dp"
                android:padding="0dp"
                android:text="&lt;"
                android:textSize="10sp"
                android:enabled="false"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_page_indicator"
                style="@style/SynthwaveText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="@string/page_1"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_next_page"
                style="@style/EdenButton.Outlined"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="&gt;"
                android:textSize="10sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
