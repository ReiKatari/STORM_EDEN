<?xml version="1.0" encoding="utf-8"?>
<org.yuzu.yuzu_emu.views.GradientBorderCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_mod"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/eden_card_background"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_mod_title"
            style="@style/SynthwaveText.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="15sp"
            android:singleLine="true"
            android:requiresFadingEdge="horizontal"
            app:layout_constraintEnd_toStartOf="@+id/button_download_mod"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Ultra 60FPS Dynamic FPS Mod" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_mod_author"
            style="@style/SynthwaveText.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:alpha="0.75"
            app:layout_constraintEnd_toStartOf="@+id/button_download_mod"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_mod_title"
            tools:text="By PixelHero • 12 450 downloads" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_download_mod"
            style="@style/EdenButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/gamebanana_download_button"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_mod_download"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_mod_author" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</org.yuzu.yuzu_emu.views.GradientBorderCardView>
